# MANDATORY PRODUCTION SECRETS
# Set these in AWS Systems Manager Parameter Store or AWS Secrets Manager

# Backend Database
DATABASE_URL=postgresql://postgres:password@database-url:5432/jobhub?schema=public

# Authentication (Cryptographic 256-bit secret e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_256_bit_cryptographic_jwt_secret_here

# AI Model Access (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Monetization (Paystack Live Keys)
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_SECRET_KEY=sk_live_your_secret_key

# Transactional Emails (Resend)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM="JobHub Global <noreply@skillskonnect.online>"

# Cloud File Storage (AWS S3 or Cloudflare R2 / S3-compatible)
# Leave unset to fall back to persistent local disk storage (/public/uploads)
S3_BUCKET_NAME=jobhub-storage
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_ENDPOINT is required for Cloudflare R2 (e.g. https://<account_id>.r2.cloudflarestorage.com) or MinIO
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.jobhubai.com or https://pub-xxxxxx.r2.dev
# S3_FORCE_PATH_STYLE=false

# Web Configuration
NEXT_PUBLIC_API_URL=https://api.jobhubai.com
